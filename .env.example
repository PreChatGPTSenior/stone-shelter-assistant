# Environment configuration template.
# Use safe example values only; never commit credentials or tokens.

COMPOSE_PROJECT_NAME=stone-shelter-assistant

# Docker Compose infrastructure (local development only).
# Copy to .env and replace password placeholders before the first startup.
POSTGRES_DB=stone_shelter_assistant
POSTGRES_USER=stone_shelter_assistant_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=55432
REDIS_PORT=56379
TYPESENSE_PORT=58108
TYPESENSE_API_KEY=replace_with_a_local_search_api_key
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PROTOCOL=http
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=10.0
QDRANT_PORT=56333
QDRANT_HOST=127.0.0.1
MINIO_ROOT_USER=stone_shelter_assistant
MINIO_ROOT_PASSWORD=replace_with_a_local_storage_password
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001

# Application PostgreSQL host when running Python on the host machine.
POSTGRES_HOST=127.0.0.1

# Local Ollama embeddings used by the application.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSION=1024

# OpenRouter models that support strict JSON Schema output (JSON arrays).
OPENROUTER_EVALUATION_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_EVALUATION_REQUEST_TIMEOUT=180000
OPENROUTER_MAX_TOKENS=3072
OPENROUTER_MAX_RETRIES=0
OPENROUTER_REQUEST_TIMEOUT=45000
OPENROUTER_SELECTION_JSON_SCHEMA_MODELS=["dots-studio/dots-3-note-preview:free","liquid/lfm-2.5-2.6b:free","liquid/lfm-3-1.7b:free","nvidia/nemotron-3.5-super-vl:free","xingchen-agi/xing4.0-29b-a4b:free","openai/gpt-6-luna","deepseek/deepseek-v4.1-flash","anthropic/claude-sonnet-5","google/gemini-3.8-flash","openai/gpt-6.1-terra"]
OPENROUTER_EVALUATION_JSON_SCHEMA_MODELS=["dots-studio/dots-3-note-preview:free","liquid/lfm-2.5-2.6b:free","liquid/lfm-3-1.7b:free","nvidia/nemotron-3.5-super-vl:free","xingchen-agi/xing4.0-29b-a4b:free","openai/gpt-6-luna","deepseek/deepseek-v4.1-flash","anthropic/claude-sonnet-5","google/gemini-3.8-flash","openai/gpt-6.1-terra"]

# Langfuse tracing.
LANGFUSE_PUBLIC_KEY=replace_with_a_langfuse_public_key
LANGFUSE_SECRET_KEY=replace_with_a_langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Future integrations; not consumed by the current application.
REDIS_HOST=127.0.0.1
MINIO_ENDPOINT=http://127.0.0.1:59000
MINIO_BUCKET=stone-photos
MINIO_DRAFT_BUCKET=stone-photo-drafts
MINIO_ENCYCLOPEDIA_BUCKET=stone-encyclopedia
