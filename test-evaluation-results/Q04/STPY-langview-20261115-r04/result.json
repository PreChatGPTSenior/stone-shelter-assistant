          "catalog_version": "en-v1",
          "concept_id": "candidate_environment_fit",
          "entry_kind": "definition",
          "text": "A recommendation requested for a stated home may express suitability to that environment. Represent the exact source wording as environmental fit; it does not claim the recommended stone intrinsically has the home’s quality. A home detail used only as background is not a fit criterion.",
          "expected": null,
          "proposed_value": null,
