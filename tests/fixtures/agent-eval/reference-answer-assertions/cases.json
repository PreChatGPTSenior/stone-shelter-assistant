  "cases": [
    {
      "id": "svetlana-observation",
      "question": "Tell me about Svetlana, her early-morning singing, and the neighbors complaints.",
      "sources": [
        {
          "source_id": "sv-bio",
          "scope": "individual",
          "file": "fixtures/stones/b19266ec-28a2-4fd3-851b-7fad50b6e175.json",
          "pointer": "/stone/biography"
        },
        {
          "source_id": "sv-observations",
          "scope": "history",
          "file": "fixtures/stones/b19266ec-28a2-4fd3-851b-7fad50b6e175.json",
          "pointer": "/shelterCase/events"
        }
      ],
      "assertions": [
        {
          "id": "morning",
          "kind": "requirement",
          "statement": "Mention staff observation of loud singing every morning at 05:00.",
          "source_ids": [
            "sv-observations"
          ]
        },
        {
          "id": "complaints",
          "kind": "requirement",
          "statement": "Mention two recorded neighbor complaints about the early-morning noise.",
          "source_ids": [
            "sv-observations"
          ]
        },
        {
          "id": "subject",
          "kind": "prohibition",
          "statement": "Do not turn the neighbors dislike of loud sounds into Svetlana herself disliking loud sounds.",
          "source_ids": [
            "sv-bio",
            "sv-observations"
          ]
        },
        {
          "id": "event-date-not-onset",
          "kind": "prohibition",
          "statement": "Do not claim the singing began on the observation date; the event date records when staff observed it, not when the behavior started.",
          "source_ids": [
            "sv-observations"
          ]
        }
      ],
      "samples": [
        {
          "id": "faithful",
          "sections": [
            {
              "scope": "individual",
              "explanation": "Svetlana enjoys loud early-morning singing on a windowsill.",
              "source_ids": [
                "sv-bio"
              ]
            },
            {
              "scope": "history",
              "explanation": "Staff observed daily loud singing at 05:00; two neighbor complaints were recorded about that noise.",
              "source_ids": [
                "sv-observations"
              ]
            }
          ],
          "expected": {
            "morning": true,
            "complaints": true,
            "subject": true,
            "event-date-not-onset": true
          }
        },
        {
          "id": "observation-omitted",
          "sections": [
            {
              "scope": "individual",
              "explanation": "Svetlana enjoys loud early-morning singing on a windowsill.",
              "source_ids": [
                "sv-bio"
              ]
            },
            {
              "scope": "history",
              "explanation": "There were two complaints from neighbors.",
              "source_ids": [
                "sv-observations"
              ]
            }
          ],
          "expected": {
            "morning": false,
            "complaints": true,
            "subject": true,
            "event-date-not-onset": true
          }
        },
        {
          "id": "wrong-subject",
          "sections": [
            {
              "scope": "individual",
              "explanation": "Svetlana enjoys loud early-morning singing on a windowsill.",
              "source_ids": [
                "sv-bio"
              ]
            },
            {
              "scope": "history",
              "explanation": "Staff observed loud singing every morning at 05:00 and recorded two neighbor complaints. Svetlana herself dislikes loud sounds.",
              "source_ids": [
                "sv-observations"
              ]
            }
          ],
          "expected": {
            "morning": true,
            "complaints": true,
            "subject": false,
            "event-date-not-onset": true
          }
        },
        {
          "id": "event-date-misread-as-start",
          "sections": [
            {
              "scope": "individual",
              "explanation": "Svetlana enjoys loud early-morning singing on a windowsill.",
              "source_ids": [
                "sv-bio"
              ]
            },
            {
              "scope": "history",
              "explanation": "Staff observed loud singing every morning at 05:00 and recorded two neighbor complaints. Svetlana began the behavior on November 2, 2026.",
              "source_ids": [
                "sv-observations"
              ]
            }
          ],
          "expected": {
            "morning": true,
            "complaints": true,
            "subject": true,
            "event-date-not-onset": false
          }
        }
      ]
    },
    {
      "id": "madame-negation",
      "question": "Is Madame Obsidian calm around vacuum cleaners, and does she enjoy human company?",
      "sources": [
        {
          "source_id": "madame-profile",
          "scope": "individual",
          "file": "fixtures/stones/67269139-e8b8-4c7d-aa58-33b88162ec70.json",
