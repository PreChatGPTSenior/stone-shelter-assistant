[
  {
    "id": "en-v1-definition-candidate_type",
    "language": "en",
    "catalog_version": "en-v1",
    "concept_id": "candidate_type",
    "entry_kind": "definition",
    "text": "A required material type of the candidate being requested. A type already in the household, an optional preference, or a negated type is not a required candidate type. Identify which entity the type modifies using the entire original question."
  },
  {
    "id": "en-v1-definition-decision_rotation_agreed",
    "language": "en",
    "catalog_version": "en-v1",
    "concept_id": "decision_rotation_agreed",
    "entry_kind": "definition",
    "text": "The user household explicitly established taking shared decisions in turns. Wishes, plans, hypotheses, questions, another household and missing information do not establish or deny this agreement. Check the proposed boolean and exact pair scope. Explicit refusal or an explicit statement that no agreement was reached supports false."
  },
  {
    "id": "en-v1-definition-decision_deadline_agreed",
    "language": "en",
    "catalog_version": "en-v1",
    "concept_id": "decision_deadline_agreed",
    "entry_kind": "definition",
    "text": "The user household explicitly established a deadline for shared decisions. A deadline for another activity does not count. Intention, requests, hypotheticals and missing information are unknown, not false. An explicit denial supports false. Preserve the household and pair scope."
  },
